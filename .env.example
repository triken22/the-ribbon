# Names only. Never commit real values; .env and .env.* are git-ignored (except this file).
# Each block says where the value actually lives. Nothing here is read automatically.

# --- Pages Functions (Cloudflare dashboard > Workers & Pages > project > Settings > Variables; plain text) ---
# docs/ANALYTICS.md. Both optional; the defaults are in site/functions/api/event.js.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_API_HOST=
# Binding (not a variable): R2 bucket bound as ISSUES, read-only use (site/docs/PUBLISH.md section 4).

# --- Publishing (`bookmark publish`, site/docs/PUBLISH.md section 1) ---
# These four go in ~/.config/weekend-bookmark/r2.env (dir 700, file 600, OUTSIDE any git checkout).
# Publish refuses an env file inside a git work tree, so do not fill in a copy of this file.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET must equal the bucket pinned in site/scripts/bookmark_publish.py (BUCKET).
R2_BUCKET=
# Optional overrides (paths, not secrets):
BOOKMARK_ENV_FILE=
BOOKMARK_GATE_DIR=
BOOKMARK_PUBLISH_LOG=

# --- GitHub Actions, environment "publish" secrets (site/docs/PUBLISH.md section 9) ---
# Preferred: one R2 API token; the R2_* values above are derived from it (site/scripts/ci_r2_env.py).
CLOUDFLARE_R2_TOKEN=
# Fallback when CLOUDFLARE_R2_TOKEN is empty: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY as above.

# Email Worker secrets: workers/email/.env.example
