# Email Worker secrets: names only. Never commit real values.
# Production: `pnpm dlx wrangler secret put RESEND_API_KEY` (from workers/email/).
# Local `wrangler dev`: copy to .dev.vars (git-ignored) and fill in there.
#
# Everything else the Worker reads is in wrangler.jsonc and is not secret:
#   vars      SITE, FROM_ISSUES, FROM_NAME, CF_MAX_ATTACHMENT_BYTES
#   bindings  EMAIL (send_email), ISSUES (R2), DB (D1), SUBSCRIBE_LIMIT (rate limit)

# Resend API key, used only as the fallback transport for PDFs over CF_MAX_ATTACHMENT_BYTES (docs/EMAIL.md).
RESEND_API_KEY=
